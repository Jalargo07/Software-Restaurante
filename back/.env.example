# ============================================
# CONFIGURACIÓN DE ENTORNO - BITEOPS BACKEND
# ============================================
# Copiar este archivo a .env y completar los valores
# NUNCA subir .env a Git

# Puerto del servidor
PORT=3000

# JWT - Clave secreta para tokens (cambiar en producción)
JWT_SECRET=CHANGE_ME

# CORS - Origen del frontend (URL de Vercel en producción)
CORS_ORIGIN=http://localhost:5173

# ============================================
# BASE DE DATOS
# ============================================

# Opción 1: PostgreSQL (Supabase / cualquier provider)
DB_DIALECT=postgres
DATABASE_URL=postgresql://postgres.[project-id]:[password]@db.[project-id].supabase.co:5432/postgres

# Opción 2: SQLite (desarrollo local)
# DB_DIALECT=sqlite
# DATABASE_URL=./data/database.sqlite

# Variables alternativas (si no usas DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=restaurantedb
# DB_USER=postgres
# DB_PASSWORD=postgres

# ============================================
# REDIS (Caché)
# ============================================

# Opción 1: Upstash (producción)
# REDIS_URL=https://[tu-db].upstash.io
# REDIS_TOKEN=[tu-token]

# Opción 2: Redis local (desarrollo)
REDIS_URL=redis://localhost:6379

# ============================================
# ALMACENAMIENTO DE IMÁGENES (S3/MinIO/R2)
# ============================================

# Opción 1: Cloudflare R2 (producción)
S3_ENDPOINT=https://[account-id].r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_NAME=biteops-images
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=https://pub-[hash].r2.dev

# Opción 2: MinIO local (desarrollo)
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=alejoadmin
# S3_SECRET_KEY=alejo1234
# S3_BUCKET_NAME=restaurante-bucket
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=http://localhost:9000

# ============================================
# ENTORNO
# ============================================
NODE_ENV=development

# PayPal
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
PAYPAL_MODE=sandbox

# OpenAI (Escaneo IA de Facturas)
OPENAI_API_KEY=CHANGE_ME
